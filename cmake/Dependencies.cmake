# Dependency paths are rooted inside this project, not the surrounding checkout.
set(AMBIBIN_JUCE_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../third_party/JUCE" CACHE PATH "JUCE source checkout")
set(AMBIBIN_SAF_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../third_party/SAF" CACHE PATH "Official SAF source checkout")
foreach(dependency IN ITEMS JUCE SAF)
    if(NOT EXISTS "${AMBIBIN_${dependency}_SOURCE}/CMakeLists.txt")
        message(FATAL_ERROR "${dependency} missing; initialize this project's submodules first.")
    endif()
endforeach()

set(JUCE_BUILD_EXTRAS OFF CACHE BOOL "" FORCE)
set(JUCE_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(JUCE_COPY_PLUGIN_AFTER_BUILD OFF CACHE BOOL "" FORCE)
add_subdirectory("${AMBIBIN_JUCE_SOURCE}" "${CMAKE_BINARY_DIR}/third_party/JUCE" EXCLUDE_FROM_ALL)

# No local SAF patches are applied. Only the official ambi_bin example is needed.
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(SAF_BUILD_EXAMPLES ON CACHE BOOL "" FORCE)
set(SAF_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(SAF_BUILD_EXTRAS OFF CACHE BOOL "" FORCE)
set(SAF_ENABLE_SOFA_READER_MODULE ON CACHE BOOL "" FORCE)
set(SAF_ENABLE_NETCDF OFF CACHE BOOL "" FORCE)
set(SAF_ENABLE_TRACKER_MODULE OFF CACHE BOOL "" FORCE)
set(SAF_ENABLE_HADES_MODULE OFF CACHE BOOL "" FORCE)
set(SAF_USE_INTEL_IPP OFF CACHE BOOL "" FORCE)
set(SAF_USE_FFTW OFF CACHE BOOL "" FORCE)
set(SAF_ENABLE_SIMD OFF CACHE BOOL "" FORCE)
set(saf_example_list ambi_bin)

if(WIN32)
    set(SAF_PERFORMANCE_LIB SAF_USE_INTEL_MKL_LP64 CACHE STRING "SAF numerical backend")
    set(AMBIBIN_MKL_ROOT "${CMAKE_CURRENT_LIST_DIR}/../third_party/mkl" CACHE PATH "Local MKL headers/import library/runtime")
    set(INTEL_MKL_HEADER_PATH "${AMBIBIN_MKL_ROOT}/include" CACHE PATH "MKL headers")
    set(INTEL_MKL_LIB "${AMBIBIN_MKL_ROOT}/lib/saf_mkl_custom_lp64.lib" CACHE FILEPATH "SAF MKL import library")
    set(AMBIBIN_MKL_RUNTIME "${AMBIBIN_MKL_ROOT}/bin/saf_mkl_custom_lp64.dll" CACHE FILEPATH "SAF MKL runtime")
    foreach(required IN ITEMS "${INTEL_MKL_HEADER_PATH}/mkl.h" "${INTEL_MKL_LIB}" "${AMBIBIN_MKL_RUNTIME}")
        if(NOT EXISTS "${required}")
            message(FATAL_ERROR "Required local numerical dependency missing: ${required}. See README.md.")
        endif()
    endforeach()
elseif(APPLE)
    set(SAF_PERFORMANCE_LIB SAF_USE_APPLE_ACCELERATE CACHE STRING "SAF numerical backend")
else()
    set(SAF_PERFORMANCE_LIB SAF_USE_OPEN_BLAS_AND_LAPACKE CACHE STRING "SAF numerical backend")
endif()
add_subdirectory("${AMBIBIN_SAF_SOURCE}" "${CMAKE_BINARY_DIR}/third_party/SAF" EXCLUDE_FROM_ALL)
if(NOT TARGET saf OR NOT TARGET saf_example_ambi_bin)
    message(FATAL_ERROR "The pinned SAF framework and ambi_bin targets are required.")
endif()
